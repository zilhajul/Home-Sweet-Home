<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    android:id="@+id/cvTenant"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top accent bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/gradient_accent_bar" />

        <!-- Main content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Tenant Image with status ring -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <!-- Status ring (background circle) -->
                <View
                    android:id="@+id/viewStatusRing"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_status_ring" />

                <!-- Tenant profile image -->
                <ImageView
                    android:id="@+id/imgTenant"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_white"
                    android:scaleType="centerCrop"
                    android:src="@drawable/account"
                    android:contentDescription="Tenant profile photo"
                    android:padding="2dp" />

            </FrameLayout>

            <!-- Divider space -->
            <View
                android:layout_width="14dp"
                android:layout_height="0dp" />

            <!-- Tenant Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <!-- Tenant Name -->
                <TextView
                    android:id="@+id/tvTenantName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John Anderson"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <View android:layout_height="4dp" android:layout_width="0dp"/>

                <!-- Phone Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/outline_add_call_24"
                        app:tint="#6C7A9C"
                        android:contentDescription="Phone" />

                    <View android:layout_width="5dp" android:layout_height="0dp"/>

                    <TextView
                        android:id="@+id/tvTenantPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+1 (555) 234-5678"
                        android:textSize="13sp"
                        android:textColor="#6C7A9C"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <View android:layout_height="4dp" android:layout_width="0dp"/>

                <!-- Address Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/location"
                        app:tint="#6C7A9C"
                        android:layout_marginTop="1dp"
                        android:contentDescription="Address" />

                    <View android:layout_width="5dp" android:layout_height="0dp"/>

                    <TextView
                        android:id="@+id/tvTenantAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="42 Maple Street, Brooklyn, NY 11201"
                        android:textSize="12sp"
                        android:textColor="#8A94AA"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingMultiplier="1.2" />

                </LinearLayout>

            </LinearLayout>

            <!-- Status Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvTenantStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:background="@drawable/bg_status_badge"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>