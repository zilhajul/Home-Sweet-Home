<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8f9fa"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ========== Header ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:background="@drawable/gradient_premium_blue">

            <!-- Back Button -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_notification_badge"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/arrow_back"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    android:contentDescription="Back" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Submit a Complaint"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We'll forward it to your landlord"
                    android:textSize="11sp"
                    android:textColor="@android:color/white"
                    android:alpha="0.75"
                    android:paddingTop="4dp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========== Illustration / Info Banner ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:background="@drawable/bg_status_active"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="24dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_launcher_background"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Info" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Your complaint will be reviewed by your landlord. Please be clear and specific."
                android:textSize="12sp"
                android:textColor="#27ae60"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- ========== Complaint Form Card ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complaint Details"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2c3e50"
                android:paddingBottom="14dp"
                android:fontFamily="sans-serif-medium" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardMaxElevation="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Complaint Type Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Describe Your Issue"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#2c3e50"
                        android:fontFamily="sans-serif-medium"
                        android:paddingBottom="10dp" />

                    <!-- Multiline Text Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilComplainText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Type your complaint here..."
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#3498db"
                        app:hintTextColor="#3498db"
                        app:counterEnabled="true"
                        app:counterMaxLength="500">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etComplainText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="6"
                            android:maxLines="10"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="500"
                            android:textSize="14sp"
                            android:textColor="#2c3e50"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="4dp"
                            android:scrollbars="vertical"
                            android:padding="4dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Character hint -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minimum 20 characters required"
                        android:textSize="11sp"
                        android:textColor="#95a5a6"
                        android:paddingTop="6dp"
                        android:fontFamily="sans-serif" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ========== Flat Info Card (Read-only) ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submitting As"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2c3e50"
                android:paddingBottom="14dp"
                android:fontFamily="sans-serif-medium" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardMaxElevation="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/gradient_stat_properties">

                    <!-- Tenant Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="14dp">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_stat_icon_revenue">
                            <ImageView
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:src="@drawable/ic_launcher_background"
                                android:scaleType="centerInside"
                                android:padding="11dp"
                                android:contentDescription="Tenant" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tenant"
                                android:textSize="11sp"
                                android:textColor="#7f8c8d"
                                android:fontFamily="sans-serif" />

                            <TextView
                                android:id="@+id/tvTenantName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ahmed Khan"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#2c3e50"
                                android:paddingTop="3dp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#e8e8e8"
                        android:layout_marginBottom="14dp" />

                    <!-- Flat & Building Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Flat"
                                android:textSize="11sp"
                                android:textColor="#7f8c8d"
                                android:fontFamily="sans-serif" />
                            <TextView
                                android:id="@+id/tvFlatName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Flat 2A"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#2c3e50"
                                android:paddingTop="4dp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#e0e0e0"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Building"
                                android:textSize="11sp"
                                android:textColor="#7f8c8d"
                                android:fontFamily="sans-serif" />
                            <TextView
                                android:id="@+id/tvBuildingName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gulshan Tower, Dhaka"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#2c3e50"
                                android:paddingTop="4dp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ========== Submit Button ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardMaxElevation="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/gradient_premium_blue">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ready to submit?"
                            android:textSize="13sp"
                            android:textColor="@android:color/white"
                            android:alpha="0.85"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your complaint will be sent immediately"
                            android:textSize="11sp"
                            android:textColor="@android:color/white"
                            android:alpha="0.70"
                            android:paddingTop="3dp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSubmitComplain"
                        android:layout_width="110dp"
                        android:layout_height="44dp"
                        android:text="Submit"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FAFCFD"
                        android:background="@color/white"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>